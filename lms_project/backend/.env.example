# Copy this file to .env and fill in real values. Never commit the real .env file.

# Static API key that every private endpoint requires in the X-API-Key header
API_KEY=change-me-api-key

# Secret used to sign JWT access tokens - use a long random value in real deployments
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of exact frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Seed accounts created at startup (no public register endpoint for these roles)
ADMIN_EMAIL=admin@lms.com
ADMIN_PASSWORD=change-me-admin-pass

INSTRUCTOR_EMAIL=instructor@lms.com
INSTRUCTOR_PASSWORD=change-me-instructor-pass
